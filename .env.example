# Copia este archivo a .env y rellena lo que uses. Nunca subas el .env al repositorio.

# ------------------------------------------------------------------- modelo
# Los modelos del pipeline (uno por nodo) se configuran en config.yaml, sección `llm`.
# MODEL_NAME solo se usa si no hay config.yaml (formato "proveedor:modelo").
MODEL_NAME=lmstudio:qwen/qwen3.5-9b
# Juez de las evaluaciones si no hay config.yaml (con config.yaml: llm.judge). Vacío = MODEL_NAME.
JUDGE_MODEL_NAME=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
MAX_LLM_CALLS=8

# --------------------------------------------------------------- embeddings
# lmstudio | openrouter | local
EMBEDDING_PROVIDER=lmstudio
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ------------------------------------------------------------------- rutas
# Lo que genera el programa (SQLite de noticias, checkpoints, índices, runs).
# "data" para seguir la estructura del README (data/app.db, data/checkpoints.db...).
STATE_DIR=data
VECTOR_STORE=memory

# ------------------------------------------------------------------ búsqueda
# duckduckgo (gratis, sin clave) | tavily (necesita TAVILY_API_KEY)
SEARCH_PROVIDER=duckduckgo
SEARCH_REGION=es-es

# ------------------------------------------------------------------- claves
OPENROUTER_API_KEY=
TAVILY_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
